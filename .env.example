# ---------------------------------------------------------------------------
# Gardening Companion — copy to .env and fill in.  NEVER commit the real .env.
#
# Only SECRET_KEY and MONGO_URI are required.  Everything else degrades
# gracefully: no GEMINI_API_KEY -> curated care data only; no AWS_S3_BUCKET ->
# images land on local disk; no GOOGLE_CLIENT_ID -> no "Sign in with Google".
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
FLASK_ENV=development
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# --- MongoDB ---------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/gardening_companion
MONGO_DB_NAME=gardening_companion

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# How often the reminder sweep runs, in minutes.
REMINDER_SWEEP_MINUTES=60

# --- SMTP (care reminders + password reset) --------------------------------
# For Gmail use an App Password, not your account password.
# For local dev, `docker compose up` gives you MailHog on port 1025 / UI :8025.
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Gardening Companion <no-reply@gardening-companion.local>
# Used to build absolute links in emails sent from Celery (no request context).
APP_BASE_URL=http://localhost:5000

# --- Gemini ----------------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- AWS S3 (plant images) -------------------------------------------------
# Leave AWS_S3_BUCKET blank to store uploads on local disk instead.
STORAGE_BACKEND=auto           # auto | s3 | local
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: MinIO / LocalStack endpoint for testing S3 without an AWS account.
AWS_S3_ENDPOINT_URL=
S3_PRESIGN_EXPIRY_SECONDS=3600

# --- Google OAuth (optional) ----------------------------------------------
# Authorized redirect URI: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Misc ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
RATELIMIT_STORAGE_URI=memory://
MAX_UPLOAD_MB=8
